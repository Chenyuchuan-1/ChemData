# =========================
# App
# =========================

APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
WEB_PORT=5173
SCIENTIFIC_HOST=127.0.0.1
SCIENTIFIC_PORT=8100
SCIENTIFIC_URL=http://127.0.0.1:8100

# =========================
# LLM
# =========================

LLM_PROVIDER=openai-compatible

LLM_BASE_URL=http://127.0.0.1:8001/v1

LLM_API_KEY=your-api-key

LLM_MODEL=gpt-5.6-sol

LLM_API_TYPE=openai-completions

LLM_TEMPERATURE=0

LLM_MAX_TOKENS=16000

LLM_TIMEOUT_MS=180000

LLM_SUPPORTS_VISION=true


# =========================
# MinerU
# =========================

MINERU_MODE=api

MINERU_API_URL=http://127.0.0.1:8000

MINERU_OUTPUT_ROOT=./data/documents

MINERU_BACKEND=pipeline

MINERU_MODEL_SOURCE=modelscope

# 0 = parse every page via adaptive chunks. >0 still caps a single request.
MINERU_MAX_PAGES=0
# Leave unset to use adaptive windows (8/16/24 pages by MB per page).
# MINERU_CHUNK_PAGES=16
# MINERU_CHUNK_OVERLAP=1


# =========================
# Storage
# =========================

STORAGE_ROOT=./data


# =========================
# Database
# =========================

DATABASE_URL=sqlite:///./data/app.db


# =========================
# Chemistry
# =========================

ATOM_MAPPER=rxnmapper

# Optional passwords for encrypted source PDFs. Do not commit real values.
PDF_PASSWORD=
# Comma-separated extras, tried after PDF_PASSWORD.
PDF_PASSWORDS=
